OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini
VISION_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=3072

MLS_ENV=development
MLS_DATA_DIR=./data
MLS_RAG_WORKING_DIR=./rag_storage
MLS_RAG_PARSER=mineru

# Backend-only cloud persistence. Prefer the current Supabase secret key.
# Never expose either secret/service-role key to clients, logs, prompts, or Git.
MLS_SUPABASE_URL=
MLS_SUPABASE_SECRET_KEY=
# Legacy compatibility only:
MLS_SUPABASE_SERVICE_ROLE_KEY=

# Backend-only authorized-user credential JSON. Prefer a cloud secret store.
# Leave blank when using Google Application Default Credentials.
MLS_GOOGLE_DRIVE_OAUTH_JSON=
